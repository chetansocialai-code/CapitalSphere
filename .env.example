# CapitalSphere — Environment Configuration

# Server & Node
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
WS_URL=ws://localhost:4000/stream

# Feature Flags
TRADING_ENABLED=false
MOCK_MARKET_DATA=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capitalsphere_db?schema=public

# Caching & Queue (Redis)
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=capitalsphere_production_super_secret_jwt_key_2026_finance_platform
JWT_EXPIRES_IN=7d

# Upstox API V3 Credentials (Keep confidential)
UPSTOX_CLIENT_ID=capitalsphere_upstox_client_id_placeholder
UPSTOX_CLIENT_SECRET=capitalsphere_upstox_client_secret_placeholder
UPSTOX_REDIRECT_URI=http://localhost:4000/api/v1/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=capitalsphere_upstox_access_token_placeholder

# External News APIs
FINNHUB_API_KEY=finnhub_api_key_placeholder
ALPHA_VANTAGE_API_KEY=alpha_vantage_key_placeholder
NEWS_API_KEY=news_api_key_placeholder

# AI Content Engine
AI_API_KEY=gemini_ai_api_key_placeholder

# Storage & CDN
STORAGE_BUCKET=capitalsphere-media-storage
CLOUDFLARE_R2_KEY=cloudflare_r2_key_placeholder
